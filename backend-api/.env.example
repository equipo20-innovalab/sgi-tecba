# Base de datos PostgreSQL (pedir a Data por canal seguro)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/innovalab

# Entorno
ENVIRONMENT=development

# CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173

# Carpeta del proyecto de datos (opcional; por defecto se busca junto a sgi-tecba).
# INNOVALAB_DATA_DIR=/ruta/a/innovalab/data
