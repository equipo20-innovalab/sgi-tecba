# Base de datos PostgreSQL (pedir a Data por canal seguro)
DATABASE_URL=postgresql+psycopg://tu_usuario:tu_contraseña@TU_HOST_SUPABASE:5432/postgres

# Entorno
ENVIRONMENT=development

# CORS (frontend Vite)
CORS_ORIGINS=http://localhost:5173

# Chat conversacional (Groq)
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# Carpeta del proyecto de datos (opcional; por defecto se busca junto a sgi-tecba).
INNOVALAB_DATA_DIR=/ruta/a/sgi-tecba/data_analytics/innovalab/data
